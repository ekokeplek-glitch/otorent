# ==============================================================================
# RYOKOURENT - ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# Ganti nilai berikut pada lingkungan deployment masing-masing.
# JANGAN SIMPAN KREDENSIAL ASLI DI VERSION CONTROL (GIT).
# ==============================================================================

# Aplikasi & WordPress
WP_ENV="development"
WP_HOME="https://example.com"
WP_SITEURL="https://example.com/wp"
WP_TIMEZONE="Asia/Jakarta"

# Database Configuration (Contoh Dummy)
DB_NAME="ryokourent_db"
DB_USER="ryokou_user"
DB_PASSWORD="dummy_secure_password_123"
DB_HOST="localhost"
DB_PREFIX="ryo_"

# Konfigurasi WhatsApp Admin Ryokourent (Contoh Dummy)
# Format internasional tanpa simbol '+' (contoh Indonesia: 628xxxxxxxxxx)
RYOKOURENT_ADMIN_WHATSAPP="6281234567890"
RYOKOURENT_ADMIN_WHATSAPP_SECONDARY="6289876543210"

# Jam Operasional Layanan
RYOKOURENT_OPERATIONAL_OPEN="07:00"
RYOKOURENT_OPERATIONAL_CLOSE="23:00"

# Pengaturan Lokasi Pool Resmi
RYOKOURENT_POOL_MALANG_NAME="Pool 1 (Dinoyo Malang)"
RYOKOURENT_POOL_MALANG_ADDRESS="Jl. MT Haryono Gg. 21 No. 23, Dinoyo, Lowokwaru, Malang"
RYOKOURENT_POOL_MALANG_MAPS="https://maps.google.com/?q=Dinoyo+Malang"

RYOKOURENT_POOL_BATU_NAME="Pool 2 (Kota Wisata Batu)"
RYOKOURENT_POOL_BATU_ADDRESS="Jl. Belakang Pompa Bensin, Jl. Diponegoro, Batu"
RYOKOURENT_POOL_BATU_MAPS="https://maps.google.com/?q=Diponegoro+Batu"

# Tarif Dasar Contoh (IDR)
RYOKOURENT_DEFAULT_DAILY_RATE=85000
RYOKOURENT_DEFAULT_WEEKLY_RATE=500000
RYOKOURENT_DEFAULT_MONTHLY_RATE=1600000
